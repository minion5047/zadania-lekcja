<Window x:Class="Stoper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Stoper Pulpitowy" Height="680" Width="440"
        MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern Rounded Button Style Base -->
        <Style x:Key="ModernBtnBase" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- START Button Style -->
        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernBtnBase}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- STOP Button Style -->
        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernBtnBase}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Lap Button Style -->
        <Style x:Key="LapButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernBtnBase}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#0369A1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <!-- Reset Button Style -->
        <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernBtnBase}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Height" Value="42"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Time Display Card -->
            <RowDefinition Height="Auto"/>
            <!-- Status Badge -->
            <RowDefinition Height="Auto"/>
            <!-- Primary Buttons (START / STOP) -->
            <RowDefinition Height="Auto"/>
            <!-- Secondary Buttons (OKRĄŻENIE / ZERUJ) -->
            <RowDefinition Height="Auto"/>
            <!-- Laps Header -->
            <RowDefinition Height="Auto"/>
            <!-- Laps List -->
            <RowDefinition Height="*"/>
            <!-- Footer Hints -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="10" Width="36" Height="36" Margin="0,0,10,0">
                    <TextBlock Text="⏱" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="STOPER DESKTOP" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                    <TextBlock Text="Aplikacja Okienkowa C# WPF" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <CheckBox x:Name="chkAlwaysOnTop"
                      Content="📌 Zawsze na wierzchu"
                      Foreground="#94A3B8"
                      FontSize="12"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      Cursor="Hand"
                      Checked="ChkAlwaysOnTop_Checked"
                      Unchecked="ChkAlwaysOnTop_Unchecked"/>
        </DockPanel>

        <!-- 1. TIME DISPLAY CARD -->
        <Border Grid.Row="1"
                Background="#131C2E"
                BorderBrush="#1E293B"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="16,22"
                Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Hours : Minutes : Seconds -->
                    <TextBlock x:Name="txtMainTime"
                               Text="00:00:00"
                               FontFamily="Consolas"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               VerticalAlignment="Bottom"/>
                    <!-- Dot -->
                    <TextBlock Text="."
                               FontFamily="Consolas"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="#0284C7"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,2"/>
                    <!-- Hundredths / Millis -->
                    <TextBlock x:Name="txtMillis"
                               Text="00"
                               FontFamily="Consolas"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,2"/>
                </StackPanel>

                <TextBlock Text="GODZ : MIN : SEK . SETNE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. STATUS BADGE -->
        <Border Grid.Row="2"
                x:Name="badgeStatus"
                Background="#1E293B"
                CornerRadius="8"
                Padding="12,5"
                HorizontalAlignment="Center"
                Margin="0,0,0,16">
            <TextBlock x:Name="txtStatus"
                       Text="GOTOWY DO STARTU"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#94A3B8"/>
        </Border>

        <!-- 3. PRIMARY BUTTONS: START & STOP -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- START BUTTON -->
            <Button x:Name="btnStart"
                    Grid.Column="0"
                    Style="{StaticResource StartButtonStyle}"
                    Click="BtnStart_Click"
                    ToolTip="Uruchom stoper (Klawisz: Spacja)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="START" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- STOP BUTTON -->
            <Button x:Name="btnStop"
                    Grid.Column="1"
                    Style="{StaticResource StopButtonStyle}"
                    IsEnabled="False"
                    Click="BtnStop_Click"
                    ToolTip="Zatrzymaj stoper (Klawisz: Spacja)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏹" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="STOP" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 4. SECONDARY BUTTONS: OKRĄŻENIE & ZERUJ -->
        <Grid Grid.Row="4" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- OKRĄŻENIE (LAP) BUTTON -->
            <Button x:Name="btnLap"
                    Grid.Column="0"
                    Style="{StaticResource LapButtonStyle}"
                    IsEnabled="False"
                    Click="BtnLap_Click"
                    ToolTip="Zapisz międzyczas (Klawisz: L)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏁" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OKRĄŻENIE" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ZERUJ (RESET) BUTTON -->
            <Button x:Name="btnReset"
                    Grid.Column="1"
                    Style="{StaticResource ResetButtonStyle}"
                    IsEnabled="False"
                    Click="BtnReset_Click"
                    ToolTip="Wyzeruj czas i okrążenia (Klawisz: R)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↺" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ZERUJ" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 5. LAPS HEADER & ACTIONS -->
        <DockPanel Grid.Row="5" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MIĘDZYCZASY (OKRĄŻENIA)"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#94A3B8"/>
                <Border Background="#1E293B" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                    <TextBlock x:Name="txtLapCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                </Border>
            </StackPanel>

            <Button x:Name="btnCopy"
                    Content="📋 Kopiuj"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Foreground="#38BDF8"
                    BorderThickness="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="BtnCopy_Click"/>
        </DockPanel>

        <!-- 6. LAPS LIST -->
        <Border Grid.Row="6"
                Background="#131C2E"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <!-- Empty Placeholder -->
                <StackPanel x:Name="pnlEmptyLaps"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="32" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,6"/>
                    <TextBlock Text="Brak zapisanych okrążeń"
                               FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Wciśnij 'OKRĄŻENIE' podczas pomiaru"
                               FontSize="11"
                               Foreground="#475569"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Scrollable List of Laps -->
                <ListView x:Name="lstLaps"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#F8FAFC"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#1E293B"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lap Number -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding LapNumberText}"
                                           FontWeight="Bold"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>

                                <!-- Lap Split Time -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SplitTimeText}"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding SplitColor}"
                                               FontSize="13"/>
                                    <Border Background="{Binding BadgeBackground}"
                                            CornerRadius="4"
                                            Padding="4,1"
                                            Margin="6,0,0,0"
                                            Visibility="{Binding BadgeVisibility}">
                                        <TextBlock Text="{Binding BadgeText}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding BadgeForeground}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Cumulative Total Time -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TotalTimeText}"
                                           FontFamily="Consolas"
                                           Foreground="#64748B"
                                           FontSize="13"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 7. FOOTER KEYBOARD HINTS -->
        <Border Grid.Row="7" Margin="0,10,0,0">
            <TextBlock Text="Skróty: Spacja = Start/Stop | L = Okrążenie | R = Zeruj"
                       FontSize="11"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
